# Dependency Upgrade Assistant 2.0 Configuration Example
# Copy this file to .env for local development

# Application Settings
APP_NAME=Dependency Upgrade Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Settings
DATABASE_PATH=dua_local.db

# Browser origins allowed to make state-changing requests (JSON list or comma-separated).
# Never use "*". Required when ENVIRONMENT=production, e.g. ["https://dua.example.internal"].
CORS_ORIGINS=[]
# Development only: loopback frontends (localhost, 127.0.0.1, [::1]) on these ports are allowed.
# Vite uses 5173 and falls back to 5174 when 5173 is busy; 4173 is `vite preview`.
DEV_FRONTEND_PORTS=[5173,5174,4173,3000]
# Host header values the API answers to (DNS-rebinding protection).
ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]

# Ollama Local AI Provider Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=30.0

# Docker Sandbox Settings
DOCKER_TIMEOUT_SECONDS=60
DOCKER_MAX_MEMORY_MB=512
DOCKER_MAX_CPUS=1.0

# Retention (hours): plans and approvals, exports, and analysis runs
PLAN_RETENTION_HOURS=24
EXPORT_RETENTION_HOURS=24
RUN_RETENTION_HOURS=168

# Python compatibility resolver (M12). Values outside 1..ceiling stop the backend from starting.
# Per-run budget T (max 600); a resolution job (two runs) is bounded by 2T.
RESOLVER_TIMEOUT_SECONDS=180
RESOLVER_MEMORY_MB=1024
RESOLVER_CPUS=1.0
RESOLVER_PIDS_LIMIT=256
RESOLVER_TMPFS_MB=512
RESOLVER_MAX_CONCURRENT=2
RESOLVER_MAX_REPORT_MB=10
RESOLVER_MAX_PACKAGES=500
