# Dependency Upgrade Assistant 2.0 Configuration Example
# Copy this file to .env for local development

# Application Settings
APP_NAME=Dependency Upgrade Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Settings
DATABASE_PATH=dua_local.db

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Ollama Local AI Provider Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=30.0

# Docker Sandbox Settings
DOCKER_TIMEOUT_SECONDS=60
DOCKER_MAX_MEMORY_MB=512
DOCKER_MAX_CPUS=1.0
